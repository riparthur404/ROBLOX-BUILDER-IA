ROBLOX_API_KEY=TON_API_ROBLOX
ROBLOX_UNIVERSE_ID=ID_UNIVERSE
ROBLOX_PLACE_ID=TON_ID_JEUX
# Port interne (reste privé)
PORT=8000

# --- Sécurité (1 = oui, 0 = non) ---
# 1 = Claude ne peut rien écrire, seulement lire
READ_ONLY=0
# Modifier le code de scripts existants (une sauvegarde est faite avant)
ALLOW_SCRIPT_EDIT=1
# Publier un .rbxl (REMPLACE le jeu publié). Fichier à mettre dans le dossier builds/
ALLOW_PUBLISH=0
# Supprimer des entrées de Data Store
ALLOW_DELETE=0
# Exécuter du Luau dans une session du jeu (expérimental)
ALLOW_LUAU=0
# Nombre maximum d'écritures par minute
MAX_WRITES_PER_MIN=20
NGROK_AUTHTOKEN=TON_TOKEN_NGROK
PANEL_PASSWORD=TON MOTS DE PASSE
NGROK_DOMAIN=TON_DOMAIN
ROBLOX_USER_ID=TON_ID_USER